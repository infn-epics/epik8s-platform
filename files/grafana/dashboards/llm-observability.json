    {
      "id": 12,
      "title": "Model Summary",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PF8A6906A485AC0C2"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PF8A6906A485AC0C2"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n          provided_model_name AS `Model`,\n          count() AS `Requests`,\n          sum(usage_details['input']) AS `Input Tokens`,\n          sum(usage_details['output']) AS `Output Tokens`,\n          round(sum(total_cost), 4) AS `Cost ($)`,\n          round(avg(dateDiff('millisecond', start_time, end_time)), 0) AS `Avg Latency (ms)`\n        FROM observations\n        WHERE is_deleted = 0 AND type = 'GENERATION' AND $__timeFilter(start_time)\n        GROUP BY `Model`\n        ORDER BY `Requests` DESC",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
