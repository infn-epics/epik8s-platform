          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(start_time) AS time, 'p50' AS metric,\n                   quantile(0.5)(dateDiff('millisecond', start_time, end_time)) AS value\n            FROM observations\n            WHERE is_deleted = 0 AND type = 'GENERATION' AND end_time IS NOT NULL AND $__timeFilter(start_time)\n            GROUP BY time\n            ORDER BY time",
