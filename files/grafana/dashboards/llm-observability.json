          },
          "editorType": "sql",
          "rawSql": "SELECT\n          multiIf(\n            data_type = 'BOOLEAN', if(value = 1, 'Positive', 'Negative'),\n            data_type = 'CATEGORICAL', coalesce(string_value, 'unknown'),\n            toString(round(value, 1))\n          ) AS metric,\n          count() AS value\n        FROM scores\n        WHERE is_deleted = 0 AND $__timeFilter(timestamp)\n        GROUP BY metric\n        ORDER BY value DESC",
