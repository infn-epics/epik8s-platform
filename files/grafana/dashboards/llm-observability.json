          "editorType": "sql",
          "rawSql": "SELECT arrayJoin(tool_call_names) AS metric, count() AS value\n        FROM observations\n        WHERE is_deleted = 0 AND $__timeFilter(start_time) AND notEmpty(tool_call_names)\n        GROUP BY metric\n        ORDER BY value DESC\n        LIMIT 20",
